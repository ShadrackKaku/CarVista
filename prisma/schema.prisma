// ─────────────────────────────────────────────────────────────
// CarVista — Prisma Schema
// Ghana's Automotive Marketplace & Car Import Platform
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════
//  AUTH & USERS
// ══════════════════════════════════════════════════════════════

enum UserRole {
  CUSTOMER
  DEALER
  PARTS_SELLER
  SERVICE_PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

model User {
  id             String     @id @default(cuid())
  name           String?
  email          String     @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  phone          String?
  role           UserRole   @default(CUSTOMER)
  status         UserStatus @default(ACTIVE)
  city           String?
  region         String?
  bio            String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts              Account[]
  sessions              Session[]
  dealer                Dealer?
  partsStore            PartsStore?
  serviceProvider       ServiceProvider?
  vehicles              Vehicle[]            @relation("VehicleSeller")
  parts                 Part[]               @relation("PartSeller")
  orders                Order[]
  reviewsWritten        Review[]             @relation("ReviewAuthor")
  importRequests        ImportRequest[]
  savedVehicles         SavedVehicle[]
  savedParts            SavedPart[]
  cartItems             CartItem[]
  quotationRequests     QuotationRequest[]
  sentMessages          Message[]            @relation("MessageSender")
  buyerConversations    Conversation[]       @relation("ConversationBuyer")
  sellerConversations   Conversation[]       @relation("ConversationSeller")
  notifications         Notification[]
  blogPosts             BlogPost[]
  passwordResetTokens   PasswordResetToken[]
  verificationTokens    VerificationToken[]
  serviceBookings       ServiceBooking[]
  inspectionBookings    InspectionBooking[]
  recordedVehicleEvents VehicleEvent[]       @relation("EventRecorder")
  escrowPlans           EscrowPlan[]
  savedSearches         SavedSearch[]
  dutyAssessments       DutyAssessment[]     @relation("AssessmentSubmitter")
  reviewedAssessments   DutyAssessment[]     @relation("AssessmentReviewer")

  @@index([role])
  @@index([email])
}

// NextAuth adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id      String   @id @default(cuid())
  userId  String
  token   String   @unique
  expires DateTime
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  userId  String
  token   String   @unique
  expires DateTime
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ══════════════════════════════════════════════════════════════
//  DEALERS / STORES / SERVICE PROVIDERS
// ══════════════════════════════════════════════════════════════

model Dealer {
  id              String  @id @default(cuid())
  userId          String  @unique
  businessName    String
  slug            String  @unique
  description     String? @db.Text
  logo            String?
  coverImage      String?
  phone           String?
  whatsapp        String?
  email           String?
  website         String?
  address         String?
  city            String?
  region          String?
  latitude        Float?
  longitude       Float?
  verified        Boolean @default(false)
  featured        Boolean @default(false)
  rating          Float   @default(0)
  reviewCount     Int     @default(0)
  yearsInBusiness Int?
  totalSales      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles     Vehicle[]
  reviews      Review[]            @relation("DealerReviews")
  verification DealerVerification?

  @@index([verified])
  @@index([city])
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

// A dealer's KYC / business-verification submission. Admin reviews it and,
// on approval, flips Dealer.verified — turning the trust badge on.
model DealerVerification {
  id                String             @id @default(cuid())
  dealerId          String             @unique
  businessRegNumber String
  taxId             String?
  contactName       String
  contactPhone      String
  idType            String // e.g. Ghana Card, Passport, Driver's License
  idNumber          String
  documentUrl       String?
  notes             String?            @db.Text
  status            VerificationStatus @default(PENDING)
  reviewNote        String?            @db.Text
  submittedAt       DateTime           @default(now())
  reviewedAt        DateTime?

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([status])
}

model PartsStore {
  id          String  @id @default(cuid())
  userId      String  @unique
  storeName   String
  slug        String  @unique
  description String? @db.Text
  logo        String?
  coverImage  String?
  phone       String?
  whatsapp    String?
  address     String?
  city        String?
  region      String?
  verified    Boolean @default(false)
  rating      Float   @default(0)
  reviewCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parts Part[]

  @@index([verified])
}

enum ServiceType {
  MECHANIC
  AUTO_ELECTRICIAN
  SPRAY_PAINTER
  CAR_WASH
  DETAILING
  INSURANCE
  DRIVING_SCHOOL
  INSPECTION
  TOWING
  TYRE_SERVICE
}

model ServiceProvider {
  id           String      @id @default(cuid())
  userId       String      @unique
  businessName String
  slug         String      @unique
  serviceType  ServiceType
  description  String?     @db.Text
  logo         String?
  coverImage   String?
  phone        String?
  whatsapp     String?
  address      String?
  city         String?
  region       String?
  latitude     Float?
  longitude    Float?
  verified     Boolean     @default(false)
  rating       Float       @default(0)
  reviewCount  Int         @default(0)
  priceRange   String?
  services     String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings ServiceBooking[]
  reviews  Review[]         @relation("ServiceReviews")

  @@index([serviceType])
  @@index([city])
}

// ══════════════════════════════════════════════════════════════
//  VEHICLES & CATALOG
// ══════════════════════════════════════════════════════════════

model Brand {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  logo     String?
  country  String?
  featured Boolean @default(false)

  models   VehicleModel[]
  vehicles Vehicle[]
}

model VehicleModel {
  id       String    @id @default(cuid())
  name     String
  slug     String
  brandId  String
  bodyType BodyType?

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]

  @@unique([brandId, slug])
  @@index([brandId])
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  PLUGIN_HYBRID
  LPG
}

enum Transmission {
  AUTOMATIC
  MANUAL
  CVT
  DUAL_CLUTCH
}

enum BodyType {
  SEDAN
  SUV
  HATCHBACK
  COUPE
  CONVERTIBLE
  WAGON
  PICKUP
  VAN
  MINIVAN
  TRUCK
  BUS
}

enum VehicleCondition {
  NEW
  FOREIGN_USED
  GHANA_USED
  SALVAGE
}

enum ImportStatus {
  NOT_IMPORTED
  AVAILABLE_FOR_IMPORT
  IMPORT_IN_PROGRESS
  CLEARED
}

enum ListingStatus {
  DRAFT
  PENDING
  ACTIVE
  SOLD
  ARCHIVED
  REJECTED
}

model Vehicle {
  id                 String           @id @default(cuid())
  slug               String           @unique
  title              String
  brandId            String
  modelId            String?
  year               Int
  price              Decimal          @db.Decimal(12, 2)
  currency           String           @default("GHS")
  negotiable         Boolean          @default(true)
  mileage            Int              @default(0)
  fuelType           FuelType
  transmission       Transmission
  engineSize         Float? // in litres
  bodyType           BodyType
  color              String?
  interiorColor      String?
  doors              Int?
  seats              Int?
  drivetrain         String? // FWD, RWD, AWD, 4WD
  condition          VehicleCondition
  vin                String?
  registrationNumber String?
  auctionGrade       String?
  location           String?
  city               String?
  region             String?

  description String?  @db.Text
  features    String[]

  // history / import
  serviceHistory  String?      @db.Text
  accidentHistory String?      @db.Text
  importStatus    ImportStatus @default(NOT_IMPORTED)
  countryOfOrigin String?

  status   ListingStatus @default(ACTIVE)
  featured Boolean       @default(false)
  verified Boolean       @default(false)
  views    Int           @default(0)

  sellerId String
  dealerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand          Brand            @relation(fields: [brandId], references: [id])
  model          VehicleModel?    @relation(fields: [modelId], references: [id])
  seller         User             @relation("VehicleSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  dealer         Dealer?          @relation(fields: [dealerId], references: [id])
  images         VehicleImage[]
  videos         VehicleVideo[]
  savedBy        SavedVehicle[]
  reviews        Review[]         @relation("VehicleReviews")
  importRequests ImportRequest[]
  passport       VehiclePassport?

  @@index([brandId])
  @@index([status])
  @@index([featured])
  @@index([price])
  @@index([year])
  @@index([condition])
  @@index([city])
}

model VehicleImage {
  id        String  @id @default(cuid())
  vehicleId String
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  category  String? // exterior, interior, engine, wheels
  order     Int     @default(0)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

enum VideoSource {
  UPLOAD
  YOUTUBE
  VIMEO
}

enum VideoCategory {
  WALKAROUND
  ENGINE
  INTERIOR
  DRIVING
  REVIEW
  TOUR_360
}

model VehicleVideo {
  id        String        @id @default(cuid())
  vehicleId String
  url       String
  thumbnail String?
  title     String?
  source    VideoSource   @default(UPLOAD)
  category  VideoCategory @default(WALKAROUND)
  order     Int           @default(0)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
}

model SavedVehicle {
  id        String   @id @default(cuid())
  userId    String
  vehicleId String
  // Baseline price for price-drop alerts — the last price we saw/notified for
  // this saved vehicle. A drop below this triggers a notification.
  lastPrice Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([userId, vehicleId])
  @@index([userId])
}

// A named marketplace search a user can return to (and, later, be alerted on).
// `query` is the vehicles-page query string, e.g. "brand=Toyota&maxPrice=200000".
model SavedSearch {
  id             String    @id @default(cuid())
  userId         String
  name           String
  query          String
  // Last time we notified this user about new matches — only vehicles created
  // after this are considered on the next run.
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Vehicle Passport (the trust graph spine) ──────────────────
// A permanent, VIN-anchored record of a vehicle's life. Events are append-only:
// this timeline is the foundational data asset the whole platform compounds on.
enum VehicleEventType {
  IMPORTED
  SHIPPED
  CLEARED
  INSPECTED
  LISTED
  PRICE_CHANGE
  SOLD
  OWNERSHIP_TRANSFER
  SERVICED
  REPAIRED
  INSURED
  REGISTERED
  MILEAGE_UPDATE
  NOTE
}

model VehiclePassport {
  id        String  @id @default(cuid())
  vin       String  @unique
  vehicleId String? @unique
  make      String?
  model     String?
  year      Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  events  VehicleEvent[]
}

model VehicleEvent {
  id           String           @id @default(cuid())
  passportId   String
  type         VehicleEventType
  title        String
  notes        String?          @db.Text
  occurredAt   DateTime         @default(now())
  verified     Boolean          @default(false)
  source       String? // system | dealer | inspection | import | admin
  recordedById String?

  createdAt DateTime @default(now())

  passport   VehiclePassport @relation(fields: [passportId], references: [id], onDelete: Cascade)
  recordedBy User?           @relation("EventRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([passportId])
  @@index([type])
}

// ══════════════════════════════════════════════════════════════
//  CAR PARTS MARKETPLACE
// ══════════════════════════════════════════════════════════════

model PartCategory {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  icon     String?
  parentId String?

  parent   PartCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children PartCategory[] @relation("CategoryTree")
  parts    Part[]
}

enum PartCondition {
  NEW
  USED
  REFURBISHED
}

model Part {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?       @db.Text
  categoryId  String
  brand       String? // part manufacturer (Bosch, Denso...)
  oemNumber   String?
  partNumber  String?
  condition   PartCondition @default(NEW)

  price         Decimal  @db.Decimal(10, 2)
  currency      String   @default("GHS")
  discountPrice Decimal? @db.Decimal(10, 2)
  stock         Int      @default(0)
  sku           String?

  // compatibility
  compatibleMakes  String[]
  compatibleModels String[]
  yearFrom         Int?
  yearTo           Int?
  fitmentPosition  String? // front, rear, left, right

  featured    Boolean       @default(false)
  status      ListingStatus @default(ACTIVE)
  rating      Float         @default(0)
  reviewCount Int           @default(0)
  views       Int           @default(0)

  sellerId String
  storeId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category   PartCategory @relation(fields: [categoryId], references: [id])
  seller     User         @relation("PartSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  store      PartsStore?  @relation(fields: [storeId], references: [id])
  images     PartImage[]
  savedBy    SavedPart[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]     @relation("PartReviews")

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@index([oemNumber])
  @@index([partNumber])
}

model PartImage {
  id        String  @id @default(cuid())
  partId    String
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  order     Int     @default(0)

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId])
}

model SavedPart {
  id        String   @id @default(cuid())
  userId    String
  partId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([userId, partId])
  @@index([userId])
}

// ══════════════════════════════════════════════════════════════
//  CART / ORDERS / PAYMENTS
// ══════════════════════════════════════════════════════════════

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  partId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([userId, partId])
  @@index([userId])
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  MOBILE_MONEY
  PAYSTACK
  BANK_TRANSFER
  CASH_ON_DELIVERY
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String
  status      OrderStatus @default(PENDING)

  // Idempotency: a client-supplied key that makes a double-submitted checkout
  // return the SAME order instead of creating a duplicate.
  idempotencyKey String? @unique

  subtotal    Decimal @db.Decimal(10, 2)
  shippingFee Decimal @default(0) @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)
  currency    String  @default("GHS")

  couponCode String?

  // shipping details
  fullName String
  phone    String
  email    String?
  address  String
  city     String
  region   String
  notes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id       String  @id @default(cuid())
  orderId  String
  partId   String
  name     String
  price    Decimal @db.Decimal(10, 2)
  quantity Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  part  Part  @relation(fields: [partId], references: [id])

  @@index([orderId])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String        @unique
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("GHS")
  reference   String        @unique
  providerRef String?
  paidAt      DateTime?

  // Refund tracking (money-back on a paid parts order).
  refundStatus RefundStatus @default(NONE)
  refundedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Coupon {
  id           String    @id @default(cuid())
  code         String    @unique
  description  String?
  discountType String    @default("PERCENT") // PERCENT | FIXED
  amount       Decimal   @db.Decimal(10, 2)
  minPurchase  Decimal?  @db.Decimal(10, 2)
  maxUses      Int?
  usedCount    Int       @default(0)
  active       Boolean   @default(true)
  expiresAt    DateTime?

  createdAt DateTime @default(now())
}

// ══════════════════════════════════════════════════════════════
//  CAR IMPORT SYSTEM
// ══════════════════════════════════════════════════════════════

enum ImportStage {
  REQUESTED
  QUOTED
  VEHICLE_SELECTED
  PURCHASED
  SHIPPING_PENDING
  IN_TRANSIT
  ARRIVED_AT_PORT
  CUSTOMS_CLEARANCE
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model ImportRequest {
  id            String  @id @default(cuid())
  requestNumber String  @unique
  userId        String
  vehicleId     String?

  // request details
  countryOfOrigin String
  auctionSource   String?
  make            String
  model           String
  year            Int
  budget          Decimal?      @db.Decimal(12, 2)
  fuelType        FuelType?
  transmission    Transmission?
  color           String?
  notes           String?       @db.Text
  auctionLink     String?

  // quotation
  quotedCif      Decimal? @db.Decimal(12, 2)
  quotedDuty     Decimal? @db.Decimal(12, 2)
  quotedShipping Decimal? @db.Decimal(12, 2)
  quotedTotal    Decimal? @db.Decimal(12, 2)

  stage            ImportStage @default(REQUESTED)
  trackingNumber   String?
  estimatedArrival DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle        Vehicle?              @relation(fields: [vehicleId], references: [id])
  trackingEvents ImportTrackingEvent[]
  escrowPlan     EscrowPlan?

  @@index([userId])
  @@index([stage])
}

model ImportTrackingEvent {
  id              String      @id @default(cuid())
  importRequestId String
  stage           ImportStage
  title           String
  description     String?     @db.Text
  location        String?
  timestamp       DateTime    @default(now())

  importRequest ImportRequest @relation(fields: [importRequestId], references: [id], onDelete: Cascade)

  @@index([importRequestId])
}

// ══════════════════════════════════════════════════════════════
//  MILESTONE ESCROW  (buyer protection for imports)
//
//  A NON-CUSTODIAL, milestone-protected installment plan. The buyer pays
//  each installment directly through Paystack (which settles to the merchant
//  account) — CarVista never holds a third-party balance, so this stays out
//  of regulated fund-custody territory. An installment only becomes payable
//  once ops verifies the matching real-world import stage, so a customer
//  never pays for a step that hasn't happened.
// ══════════════════════════════════════════════════════════════

enum EscrowPlanStatus {
  DRAFT // admin is still setting it up; buyer can't pay yet
  ACTIVE // buyer can pay unlocked installments
  COMPLETED // every installment paid
  CANCELLED
}

enum EscrowMilestoneStatus {
  LOCKED // not payable yet (import hasn't reached the unlock stage)
  PROCESSING // buyer started a payment, awaiting Paystack confirmation
  PAID // confirmed
}

enum RefundStatus {
  NONE // no refund requested
  PENDING // refund submitted to Paystack, awaiting settlement
  REFUNDED // Paystack confirmed the money went back to the buyer
  FAILED // Paystack could not process the refund
}

model EscrowPlan {
  id              String           @id @default(cuid())
  importRequestId String           @unique
  userId          String // denormalized owner, for fast authorization
  totalAmount     Decimal          @db.Decimal(12, 2)
  currency        String           @default("GHS")
  status          EscrowPlanStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  importRequest ImportRequest     @relation(fields: [importRequestId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones    EscrowMilestone[]

  @@index([userId])
}

model EscrowMilestone {
  id          String                @id @default(cuid())
  planId      String
  sequence    Int
  label       String
  description String?               @db.Text
  amount      Decimal               @db.Decimal(12, 2)
  unlockStage ImportStage // becomes payable when the import reaches this stage
  status      EscrowMilestoneStatus @default(LOCKED)

  // Each installment is its own Paystack charge.
  method      PaymentMethod?
  reference   String?        @unique
  providerRef String?
  paidAt      DateTime?

  // Refund tracking (money-back when a plan is cancelled after payment).
  refundStatus RefundStatus @default(NONE)
  refundedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan EscrowPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model QuotationRequest {
  id      String  @id @default(cuid())
  userId  String?
  name    String
  email   String
  phone   String
  subject String
  message String  @db.Text
  type    String  @default("GENERAL") // GENERAL | IMPORT | SOURCING | PART
  status  String  @default("OPEN") // OPEN | RESPONDED | CLOSED

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([status])
}

// ══════════════════════════════════════════════════════════════
//  DUTY & SHIPPING RATES (admin-configurable)
// ══════════════════════════════════════════════════════════════

model DutyRate {
  id        String   @id @default(cuid())
  // matching criteria
  category  String // e.g. "SEDAN_UNDER_1900CC", "SUV_OVER_3000CC"
  label     String
  engineMin Int? // cc
  engineMax Int? // cc
  bodyTypes String[] // applicable body types
  fuelTypes String[]

  // rates (percentages, 0-100)
  importDutyRate Float @default(20)
  vatRate        Float @default(15)
  nhilRate       Float @default(2.5)
  getfundRate    Float @default(2.5)
  covidLevyRate  Float @default(1)
  ecowasLevyRate Float @default(0.5)
  examinationFee Float @default(0.5)
  networkCharge  Float @default(0.4)

  active        Boolean  @default(true)
  effectiveFrom DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// Depreciation schedule for over-age penalties / valuation
model OverageRate {
  id          String  @id @default(cuid())
  minAge      Int // years
  maxAge      Int
  penaltyRate Float // % penalty on CIF for over-aged vehicles
  active      Boolean @default(true)
}

model ShippingRate {
  id              String  @id @default(cuid())
  originCountry   String
  originPort      String
  destinationPort String  @default("Tema")
  method          String // RORO | CONTAINER_20 | CONTAINER_40
  vehicleClass    String // SEDAN | SUV | PICKUP | BUS
  cost            Decimal @db.Decimal(10, 2)
  currency        String  @default("USD")
  transitDaysMin  Int     @default(21)
  transitDaysMax  Int     @default(45)
  active          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([originCountry])
  @@index([method])
}

// Saved calculation results (for logged-in users / analytics)
model DutyCalculation {
  id         String  @id @default(cuid())
  userId     String?
  make       String?
  model      String?
  year       Int
  cifValue   Decimal @db.Decimal(12, 2)
  engineSize Int
  fuelType   String
  bodyType   String

  importDuty      Decimal @db.Decimal(12, 2)
  vat             Decimal @db.Decimal(12, 2)
  nhil            Decimal @db.Decimal(12, 2)
  getfund         Decimal @db.Decimal(12, 2)
  otherLevies     Decimal @db.Decimal(12, 2)
  processingFees  Decimal @db.Decimal(12, 2)
  totalLandedCost Decimal @db.Decimal(12, 2)
  currency        String  @default("GHS")

  createdAt DateTime @default(now())

  @@index([userId])
}

// ICUMS's own coded vehicle taxonomy (from the used-vehicle duty checker's
// Make / Model popups — e.g. 00042 = Toyota, 00856 = Camry). Our forms speak
// this vocabulary so every collected observation joins cleanly to the
// catalogue GRA actually assesses against. Seeded with verified codes;
// extended via the admin bulk import.
model IcumsMake {
  code String @id // 5-digit ICUMS make code, e.g. "00042"
  name String // "Toyota"

  models IcumsModel[]

  updatedAt DateTime @default(now()) @updatedAt

  @@index([name])
}

model IcumsModel {
  code     String @id // 5-digit ICUMS model code, e.g. "00856"
  name     String // "Camry"
  makeCode String

  make IcumsMake @relation(fields: [makeCode], references: [code], onDelete: Cascade)

  updatedAt DateTime @default(now()) @updatedAt

  @@index([makeCode])
  @@index([name])
}

// GRA's reference "new value" for a specific vehicle spec, as shown on the
// ICUMS checker. Depreciation and freight are applied ON TOP of this at
// assessment time, so the HDV itself is stable until GRA revalues — which is
// what lets a modest, slowly-refreshed reference table power accurate quotes
// without any live feed. Distinct from DutyAssessment (a transaction record):
// this is long-lived reference data.
model HdvReference {
  id String @id @default(cuid())

  // Normalised (uppercased) identity — "" for an unknown trim, so the unique
  // index still applies (NULLs would not collide in Postgres).
  make  String
  model String
  year  Int
  trim  String @default("")

  icumsMakeCode  String?
  icumsModelCode String?

  hdv      Decimal @db.Decimal(14, 2)
  currency String  @default("USD")
  hsCode   String?

  // How many observations back this value — confidence in the reference.
  observationCount Int      @default(1)
  lastObservedAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([make, model, year, trim])
  @@index([make, model, year])
}

// Where a duty-assessment observation came from.
enum AssessmentSource {
  PLATFORM_DEAL // a CarVista-managed import that cleared
  AGENT // logged by a partner clearing agent
  COMMUNITY // public "check my duty bill" submission
  ICUMS_LOOKUP // read off the public ICUMS used-vehicle checker
}

enum AssessmentStatus {
  PENDING
  VERIFIED
  REJECTED
}

// A REAL customs outcome: what ICUMS actually assessed for a specific
// vehicle. This is the training data for the landed-cost engine — every
// verified row sharpens the HDV prediction. Field names mirror the ICUMS
// "Tax Result" screen (Details tab) so ops can transcribe 1:1.
model DutyAssessment {
  id String @id @default(cuid())

  // ---- Vehicle identity (ICUMS Details tab) ----
  // Optional: a tax bill carries the chassis, but the checker's results list
  // (our highest-volume source) identifies cars by trim/year only.
  chassisNumber     String?
  make              String
  modelType         String
  trimLevel         String?
  vehicleType       String? // ICUMS vehicle-type label (e.g. Saloon, SUV)
  engineNo          String?
  engineSizeCc      Int?
  yearOfManufacture Int
  originCode        String? // country-of-origin code
  color             String?
  fuelType          String?

  // ---- Classification + money (ICUMS Details tab) ----
  hsCode        String?
  hsDescription String?
  hdv           Decimal? @db.Decimal(14, 2) // Home Delivery Value
  hdvCurrency   String   @default("USD")
  fobNcy        Decimal? @db.Decimal(14, 2) // FOB in GHS ("national currency")
  cifNcy        Decimal? @db.Decimal(14, 2) // CIF in GHS
  totalTax      Decimal  @db.Decimal(14, 2) // GHS — the number that matters
  // Itemised "Tax List" tab lines: [{ name, rate, amount }, …]
  taxLines      Json?

  // ---- Assessment context ----
  assessedAt   DateTime? // date on the tax bill
  port         String    @default("Tema")
  // GHS per USD applied on this assessment (visible per row in the ICUMS
  // checker) — lets us track the weekly customs FX rate from observations.
  exchangeRate Decimal?  @db.Decimal(10, 4)

  // ICUMS taxonomy codes when the submission came from our coded pickers —
  // deliberately loose (no FK) so a submission never fails on a code the
  // catalogue hasn't imported yet.
  icumsMakeCode  String?
  icumsModelCode String?

  // ---- Provenance + verification (one bad bill must not poison a cohort) ----
  source          AssessmentSource
  status          AssessmentStatus @default(PENDING)
  documentUrls    String[] // tax-bill photos / PDFs
  notes           String?          @db.Text
  submittedById   String?
  submittedBy     User?            @relation("AssessmentSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById    String?
  reviewedBy      User?            @relation("AssessmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?

  // What our engine predicted at quote time, if this car was quoted —
  // the residual (totalTax − predictedTotalTax) is the calibration signal.
  predictedTotalTax Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chassisNumber])
  @@index([make, modelType, yearOfManufacture])
  @@index([status])
}

// ══════════════════════════════════════════════════════════════
//  REVIEWS / MESSAGING / NOTIFICATIONS / BLOG
// ══════════════════════════════════════════════════════════════

model Review {
  id       String  @id @default(cuid())
  authorId String
  rating   Int // 1-5
  title    String?
  comment  String  @db.Text
  verified Boolean @default(false)

  // polymorphic-ish targets (one set per review)
  vehicleId         String?
  partId            String?
  dealerId          String?
  serviceProviderId String?

  createdAt DateTime @default(now())

  author          User             @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  vehicle         Vehicle?         @relation("VehicleReviews", fields: [vehicleId], references: [id], onDelete: Cascade)
  part            Part?            @relation("PartReviews", fields: [partId], references: [id], onDelete: Cascade)
  dealer          Dealer?          @relation("DealerReviews", fields: [dealerId], references: [id], onDelete: Cascade)
  serviceProvider ServiceProvider? @relation("ServiceReviews", fields: [serviceProviderId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([partId])
  @@index([dealerId])
  @@index([serviceProviderId])
}

// A private thread between a buyer (who started it) and a seller (the listing
// owner), optionally about a specific vehicle or part. Both sides can post
// messages back and forth.
model Conversation {
  id       String @id @default(cuid())
  buyerId  String
  sellerId String

  // optional listing context
  vehicleId String?
  partId    String?
  subject   String?

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  buyer    User      @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([lastMessageAt])
}

model Message {
  id             String  @id @default(cuid())
  conversationId String
  senderId       String
  body           String  @db.Text
  // Whether the *other* participant has read this message yet.
  read           Boolean @default(false)

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

enum NotificationType {
  ORDER
  IMPORT
  MESSAGE
  REVIEW
  SYSTEM
  PROMOTION
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType @default(SYSTEM)
  title  String
  body   String?          @db.Text
  link   String?
  read   Boolean          @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model BlogCategory {
  id    String     @id @default(cuid())
  name  String     @unique
  slug  String     @unique
  posts BlogPost[]
}

model BlogPost {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  excerpt    String?  @db.Text
  content    String   @db.Text
  coverImage String?
  published  Boolean  @default(false)
  featured   Boolean  @default(false)
  views      Int      @default(0)
  readTime   Int      @default(5)
  authorId   String
  categoryId String?
  tags       String[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author   User          @relation(fields: [authorId], references: [id])
  category BlogCategory? @relation(fields: [categoryId], references: [id])

  @@index([published])
  @@index([slug])
}

// ══════════════════════════════════════════════════════════════
//  SERVICES / INSPECTION BOOKINGS
// ══════════════════════════════════════════════════════════════

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model ServiceBooking {
  id                String        @id @default(cuid())
  bookingNumber     String        @unique
  userId            String
  serviceProviderId String
  serviceType       ServiceType
  scheduledAt       DateTime
  status            BookingStatus @default(PENDING)
  notes             String?       @db.Text
  vehicleInfo       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceProvider ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([serviceProviderId])
}

model InspectionBooking {
  id            String        @id @default(cuid())
  bookingNumber String        @unique
  userId        String
  vehicleInfo   String
  location      String
  scheduledAt   DateTime
  status        BookingStatus @default(PENDING)
  notes         String?       @db.Text

  // Inspection report (filled in once the inspection is done).
  overallGrade  String? // e.g. A, B, C or a 1–5 score
  reportSummary String?   @db.Text
  reportUrl     String? // link to the full PDF, if any
  inspectedAt   DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}


# ─────────────────────────────────────────────────────────────
# CarVista — Environment Variables (TEMPLATE)
# Copy this file to `.env` and fill in REAL values there.
# NEVER put real secrets in this file — it is committed to git.
# Real values belong in `.env` (git-ignored) and in your host's
# dashboard (e.g. Vercel → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# ---- Database (PostgreSQL) ----
# Local:   postgresql://postgres:postgres@localhost:5432/carvista?schema=public
# Railway/Supabase/Neon: use the connection string they provide.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# ---- NextAuth ----
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ---- Google OAuth ----
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Email ----
# Preferred: Resend (https://resend.com) — get an API key, verify a sender domain.
RESEND_API_KEY=""
# The "from" address (must be on a domain you've verified with your provider).
EMAIL_FROM="CarVista <no-reply@carvista.com.gh>"

# Alternative: any SMTP provider (used only if RESEND_API_KEY is not set).
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# ---- Paystack (payments) ----
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# ---- Cloudinary (media uploads) ----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="carvista_unsigned"

# ---- Rate limiting (Upstash Redis) ----
# Optional but STRONGLY recommended in production. Create a free Redis DB at
# https://console.upstash.com → copy the REST URL + token. Without these the
# app falls back to a per-instance in-memory limiter (fine for local/dev, but
# bypassable across serverless instances on Vercel).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- App ----
# Optional: looping background video for the homepage hero. Point this at an
# .mp4 URL (e.g. a Cloudinary video upload). If unset, the hero shows an
# animated photo instead.
NEXT_PUBLIC_HERO_VIDEO_URL=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CarVista"
NEXT_PUBLIC_WHATSAPP_NUMBER="233200000000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@carvista.com.gh"

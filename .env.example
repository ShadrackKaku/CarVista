# ─────────────────────────────────────────────────────────────
# CarVista — Environment Variables (TEMPLATE)
# Copy this file to `.env` and fill in REAL values there.
# NEVER put real secrets in this file — it is committed to git.
# Real values belong in `.env` (git-ignored) and in your host's
# dashboard (e.g. Vercel → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# ---- Database (PostgreSQL) ----
# Local:   postgresql://postgres:postgres@localhost:5432/carvista?schema=public
# Railway/Supabase/Neon: use the connection string they provide.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# ---- NextAuth ----
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ---- Google OAuth ----
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Email (SMTP) — verification & password reset ----
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="CarVista <no-reply@carvista.com.gh>"

# ---- Paystack (payments) ----
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# ---- Cloudinary (media uploads) ----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="carvista_unsigned"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CarVista"
NEXT_PUBLIC_WHATSAPP_NUMBER="233200000000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@carvista.com.gh"
